<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chandrayaan-2 Multi-modal Correspondence"
        android:textColor="@color/on_surface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hint_url"
        android:textSize="12sp"
        android:textColor="@color/accent"
        android:paddingTop="4dp" />

    <Button
        android:id="@+id/btnSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lbl_source"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnRef"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lbl_ref"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnProcess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_process"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/accent" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/on_surface"
        android:paddingTop="8dp"
        android:text="Ready. Load source &amp; reference images." />
</LinearLayout>
